# ---- Local development environment ----
# Copy to .env.local and fill in. In production these come from
# apphosting.yaml env + Cloud Secret Manager (do NOT commit real values).

# Cloud SQL (Postgres)
# Connection name: PROJECT:REGION:INSTANCE
CLOUD_SQL_INSTANCE=project:region:instance
DB_NAME=screening
DB_IP_TYPE=PUBLIC            # PUBLIC | PRIVATE | PSC

# --- Auth to Cloud SQL: pick ONE ---
# (A) IAM auth (recommended in prod via the runtime service account)
DB_IAM_USER=sa-name@project.iam
# (B) Password auth (handy for local dev against a local/proxied Postgres)
# DB_USER=postgres
# DB_PASSWORD=postgres

# Local-only escape hatch: a plain Postgres URL for `drizzle-kit` and local
# tests, bypassing the Cloud SQL connector entirely.
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/screening

# Firebase client config (public) — JSON string
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","appId":""}

# Firebase Admin SDK
# In prod on App Hosting, Application Default Credentials are used automatically.
# For local dev, point at a downloaded service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=project.firebasestorage.app

# Session cookie lifetime (days) for admin sessions
ADMIN_SESSION_DAYS=5

# Shared secret protecting the /api/cron/sweep finalizer endpoint
SWEEP_SECRET=change-me

# Dedicated HMAC secret for candidate in-test session cookies (do NOT reuse
# SWEEP_SECRET — separate trust domains, separate rotation)
CANDIDATE_COOKIE_SECRET=change-me-too

# Invite-link default expiry (days)
INVITE_EXPIRY_DAYS=7
